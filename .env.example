# BantuDana — konfigurasi environment untuk Vercel + Turso
# Salin file ini menjadi `.env` untuk keperluan LOKAL saja:
#   cp .env.example .env
# JANGAN commit file `.env` ke git — file itu berisi token rahasia
# (sudah dikecualikan di .gitignore). Untuk deployment Vercel, isi
# variabel yang sama di: Vercel Dashboard → Project → Settings →
# Environment Variables (bukan lewat file .env).

# URL database Turso (WAJIB).
# Didapat dari:  turso db show --url
#             atau dashboard Turso → database → Connect.
# Contoh: libsql://bantudana-xxxxxxxx.turso.io
# Untuk smoke test LOKAL tanpa akun Turso, boleh memakai file lokal:
#   TURSO_DATABASE_URL=file:/tmp/bantudana-smoke.db
TURSO_DATABASE_URL=

# Token auth database Turso (WAJIB untuk URL libsql://, RAHASIA).
# Didapat dari:  turso db tokens create bantudana
#             atau dashboard Turso → database → Connect → token.
# Jangan bagikan token ini ke siapa pun dan jangan tempel di chat.
TURSO_AUTH_TOKEN=

# PORT hanya dipakai server lokal (npm run dev:local). Vercel tidak
# memakainya — port function diatur otomatis oleh Vercel.
PORT=3102
